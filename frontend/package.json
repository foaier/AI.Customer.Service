{
    "name": "ai-customer-service-frontend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview --host 0.0.0.0",
        "typecheck": "tsc -b --pretty",
        "lint": "eslint src vite.config.ts",
        "lint:fix": "eslint src vite.config.ts --fix",
        "format": "prettier --write src vite.config.ts eslint.config.js index.html tsconfig*.json package.json README.md",
        "format:check": "prettier --check src vite.config.ts eslint.config.js index.html tsconfig*.json package.json README.md",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:browser": "node ../tests/browser/run.mjs",
        "test:frontend": "node ../tests/browser/frontend.mjs",
        "test:migrations": "node ../tests/migrations/backend-contracts.mjs",
        "format:sql": "node ../scripts/format-sql.mjs"
    },
    "dependencies": {
        "lucide-react": "^0.468.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.9.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.56.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/node": "^24.19.2",
        "@types/react": "^19.1.16",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.10.1",
        "sql-formatter": "^15.6.10",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8",
        "vitest": "^4.1.12"
    }
}
